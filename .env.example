# Local Supabase (ports shifted to 55xxx in supabase/config.toml; `supabase status` prints these)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=inspection-media

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest            # a current Gemini Flash model id

# Your tunnel's https URL (no trailing slash). Also added to allowedDevOrigins automatically.
PUBLIC_BASE_URL=

# Clip timing
CLIP_PAD_BEFORE_MS=3000
CLIP_PAD_AFTER_MS=3000
MAX_AUTO_CLIP_MS=20000
MAX_RECORDING_MS=600000

ENABLE_REPROCESS=true    # development only; set to false for the demo
